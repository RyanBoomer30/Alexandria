# Copy to .env. Values are read with the PAPERPATH_ prefix.

PAPERPATH_DATABASE_URL=sqlite:///./data/paperpath.db
PAPERPATH_DATA_DIR=./data
# arXiv asks clients to identify themselves. Use a real address before bulk fetches.
PAPERPATH_CONTACT_EMAIL=

# One OpenRouter key. Chat completions and Jev decisions both bill this account.
PAPERPATH_OPENROUTER_API_KEY=

# Chat model for extraction, edge proposals, and explanations.
PAPERPATH_FRONTIER_BASE_URL=https://openrouter.ai/api/v1
PAPERPATH_FRONTIER_MODEL=openai/gpt-4.1

# Jev via the OpenRouter Decisions API. Output is typed probabilities, not prose.
PAPERPATH_JEV_BASE_URL=https://openrouter.ai/api/alpha
PAPERPATH_JEV_MODEL=typesafe/jev-1.13
# frontier | none. Used when Jev is unconfigured or a call fails.
PAPERPATH_JEV_FALLBACK=frontier

PAPERPATH_S2_API_KEY=
PAPERPATH_OPENALEX_MAILTO=
